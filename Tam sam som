<!DOCTYPE html>
<html lang="es" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora Estratégica TAM, SAM, SOM</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- html2pdf -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#3b82f6',
                        secondary: '#10b981',
                        accent: '#8b5cf6',
                    }
                }
            }
        }
    </script>
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .dark .glass-card {
            background: rgba(30, 41, 59, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .transition-all { transition: all 0.3s ease; }
        .concentric-circle {
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            transition: all 0.5s ease;
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-sans transition-colors duration-300">

    <!-- BARRA DE NAVEGACIÓN -->
    <nav class="sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b dark:border-slate-700 p-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i class="fas fa-chart-pie text-primary text-2xl"></i>
                <span class="text-xl font-bold tracking-tight">MarketScale <span class="text-primary text-sm">PRO</span></span>
            </div>
            <div class="flex items-center space-x-4">
                <button onclick="toggleDarkMode()" class="p-2 rounded-full hover:bg-slate-200 dark:hover:bg-slate-800 transition-all">
                    <i id="theme-icon" class="fas fa-moon"></i>
                </button>
                <button onclick="window.print()" class="hidden md:block bg-slate-800 dark:bg-slate-100 dark:text-slate-900 text-white px-4 py-2 rounded-lg text-sm font-semibold">
                    <i class="fas fa-print mr-2"></i>Imprimir
                </button>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto p-4 md:p-8 space-y-12">
        
        <!-- HEADER & EXPLICACIÓN -->
        <header class="text-center space-y-4 py-8 animate-fade-in">
            <h1 class="text-4xl md:text-5xl font-extrabold bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">
                Calculadora de TAM, SAM y SOM
            </h1>
            <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
                Define el potencial real de tu negocio utilizando el modelo de dimensionamiento de mercado más aceptado por inversores a nivel mundial.
            </p>
        </header>

        <!-- SECCIÓN EDUCATIVA -->
        <section class="grid md:grid-cols-3 gap-6">
            <div class="glass-card p-6 rounded-2xl shadow-sm border-l-4 border-blue-500">
                <h3 class="font-bold text-xl mb-2 flex items-center">
                    <span class="bg-blue-100 text-blue-600 w-8 h-8 rounded-lg flex items-center justify-center mr-2">TAM</span>
                </h3>
                <p class="text-sm font-semibold text-slate-500 mb-2 italic">Total Addressable Market</p>
                <p class="text-slate-600 dark:text-slate-300">Representa la demanda total del mercado para un producto o servicio. Es el ingreso máximo que podrías generar si tuvieras el 100% de cuota.</p>
                <p class="mt-2 text-xs text-blue-500 font-bold">Ej: Todo el mercado mundial de café.</p>
            </div>
            <div class="glass-card p-6 rounded-2xl shadow-sm border-l-4 border-green-500">
                <h3 class="font-bold text-xl mb-2 flex items-center">
                    <span class="bg-green-100 text-green-600 w-8 h-8 rounded-lg flex items-center justify-center mr-2">SAM</span>
                </h3>
                <p class="text-sm font-semibold text-slate-500 mb-2 italic">Serviceable Available Market</p>
                <p class="text-slate-600 dark:text-slate-300">Es la parte del TAM que es alcanzable según tu modelo de negocio, tecnología y ubicación geográfica.</p>
                <p class="mt-2 text-xs text-green-500 font-bold">Ej: Consumidores de café orgánico en tu país.</p>
            </div>
            <div class="glass-card p-6 rounded-2xl shadow-sm border-l-4 border-purple-500">
                <h3 class="font-bold text-xl mb-2 flex items-center">
                    <span class="bg-purple-100 text-purple-600 w-8 h-8 rounded-lg flex items-center justify-center mr-2">SOM</span>
                </h3>
                <p class="text-sm font-semibold text-slate-500 mb-2 italic">Serviceable Obtainable Market</p>
                <p class="text-slate-600 dark:text-slate-300">Es la porción del SAM que realmente puedes capturar a corto/mediano plazo con tus recursos actuales.</p>
                <p class="mt-2 text-xs text-purple-500 font-bold">Ej: Clientes en tu ciudad el primer año.</p>
            </div>
        </section>

        <!-- HERRAMIENTA INTERACTIVA -->
        <div id="report-content" class="grid lg:grid-cols-12 gap-8">
            
            <!-- FORMULARIO -->
            <div class="lg:col-span-5 space-y-6">
                <div class="glass-card p-6 rounded-2xl shadow-xl">
                    <h2 class="text-xl font-bold mb-6 flex items-center">
                        <i class="fas fa-sliders-h mr-2 text-primary"></i> Configura tus Datos
                    </h2>
                    
                    <!-- Presets -->
                    <div class="mb-6">
                        <label class="text-xs font-bold uppercase text-slate-400 block mb-2">Cargar Ejemplo:</label>
                        <div class="flex flex-wrap gap-2">
                            <button onclick="loadPreset('saas')" class="px-3 py-1 bg-slate-100 dark:bg-slate-700 hover:bg-primary hover:text-white rounded-full text-xs transition-all">SaaS B2B</button>
                            <button onclick="loadPreset('cafe')" class="px-3 py-1 bg-slate-100 dark:bg-slate-700 hover:bg-primary hover:text-white rounded-full text-xs transition-all">Cafetería Local</button>
                            <button onclick="loadPreset('gym')" class="px-3 py-1 bg-slate-100 dark:bg-slate-700 hover:bg-primary hover:text-white rounded-full text-xs transition-all">Gimnasio</button>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-medium mb-1">Mercado Total (TAM Monetario $)</label>
                            <input type="number" id="tam-input" value="1000000" class="w-full p-3 rounded-xl border dark:bg-slate-800 dark:border-slate-700 focus:ring-2 focus:ring-primary outline-none transition-all" oninput="calculate()">
                        </div>

                        <div>
                            <div class="flex justify-between mb-1">
                                <label class="block text-sm font-medium">Porcentaje SAM (Accesible %)</label>
                                <span id="sam-perc-val" class="text-primary font-bold">30%</span>
                            </div>
                            <input type="range" id="sam-range" min="1" max="100" value="30" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-primary" oninput="calculate()">
                        </div>

                        <div>
                            <div class="flex justify-between mb-1">
                                <label class="block text-sm font-medium">Porcentaje SOM (Obtenible %)</label>
                                <span id="som-perc-val" class="text-secondary font-bold">5%</span>
                            </div>
                            <input type="range" id="som-range" min="1" max="100" value="5" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-secondary" oninput="calculate()">
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium mb-1">Precio Prom. ($)</label>
                                <input type="number" id="price-input" value="100" class="w-full p-3 rounded-xl border dark:bg-slate-800 dark:border-slate-700" oninput="calculate()">
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1">Clientes Pot.</label>
                                <input type="number" id="clients-input" value="10000" class="w-full p-3 rounded-xl border dark:bg-slate-800 dark:border-slate-700" oninput="calculate()">
                            </div>
                        </div>
                    </div>

                    <div class="flex space-x-2 mt-8">
                        <button onclick="resetData()" class="flex-1 py-3 border border-slate-300 dark:border-slate-600 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-700 transition-all font-semibold">
                            <i class="fas fa-undo mr-2"></i>Limpiar
                        </button>
                    </div>
                </div>
            </div>

            <!-- RESULTADOS Y GRÁFICAS -->
            <div class="lg:col-span-7 space-y-6">
                <!-- Tarjetas de resultados -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
                    <div class="glass-card p-4 rounded-2xl">
                        <p class="text-xs font-bold text-slate-500 uppercase">Total (TAM)</p>
                        <p id="tam-res" class="text-2xl font-black text-primary">$0</p>
                    </div>
                    <div class="glass-card p-4 rounded-2xl">
                        <p class="text-xs font-bold text-slate-500 uppercase">Serviceable (SAM)</p>
                        <p id="sam-res" class="text-2xl font-black text-slate-700 dark:text-slate-200">$0</p>
                    </div>
                    <div class="glass-card p-4 rounded-2xl">
                        <p class="text-xs font-bold text-slate-500 uppercase">Obtainable (SOM)</p>
                        <p id="som-res" class="text-2xl font-black text-secondary">$0</p>
                    </div>
                </div>

                <!-- Gráfico de Dona -->
                <div class="glass-card p-6 rounded-2xl min-h-[400px] flex flex-col items-center justify-center">
                    <h3 class="text-lg font-bold mb-4">Distribución del Mercado</h3>
                    <div class="w-full max-w-[300px]">
                        <canvas id="marketChart"></canvas>
                    </div>
                </div>

                <!-- Resumen Ejecutivo -->
                <div class="glass-card p-6 rounded-2xl bg-gradient-to-br from-primary/5 to-accent/5">
                    <h3 class="text-xl font-bold mb-4 flex items-center">
                        <i class="fas fa-file-alt mr-2 text-primary"></i> Resumen Ejecutivo Automático
                    </h3>
                    <div id="executive-summary" class="text-slate-600 dark:text-slate-300 space-y-3">
                        <!-- Generado dinámicamente -->
                    </div>
                </div>
            </div>
        </div>

        <!-- DIAGRAMA VISUAL -->
        <section class="py-10">
            <h2 class="text-2xl font-bold text-center mb-10">Visualización de Capas de Mercado</h2>
            <div class="relative flex items-center justify-center h-80">
                <div id="v-tam" class="concentric-circle bg-blue-500/20 border-2 border-blue-500 absolute" style="width: 300px; height: 300px;">
                    <span class="absolute top-4 font-bold text-blue-600">TAM</span>
                    <div id="v-sam" class="concentric-circle bg-green-500/20 border-2 border-green-500 absolute" style="width: 200px; height: 200px;">
                        <span class="absolute top-4 font-bold text-green-600">SAM</span>
                        <div id="v-som" class="concentric-circle bg-purple-500/20 border-2 border-purple-500 absolute" style="width: 100px; height: 100px;">
                            <span class="font-bold text-purple-600">SOM</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- RECOMENDACIONES -->
        <section class="grid md:grid-cols-2 gap-8">
            <div class="glass-card p-6 rounded-2xl">
                <h3 class="font-bold text-lg mb-4 text-primary"><i class="fas fa-lightbulb mr-2"></i>Recomendaciones para tu SOM</h3>
                <ul id="recommendations-list" class="space-y-3 text-sm">
                    <!-- Dinámico -->
                </ul>
            </div>
            <div class="glass-card p-6 rounded-2xl">
                <h3 class="font-bold text-lg mb-4 text-accent"><i class="fas fa-question-circle mr-2"></i>Preguntas Frecuentes</h3>
                <div class="space-y-2">
                    <details class="group border-b border-slate-200 dark:border-slate-700 pb-2">
                        <summary class="list-none cursor-pointer font-medium flex justify-between items-center">
                            ¿Cada cuánto debo actualizar el TAM?
                            <i class="fas fa-chevron-down group-open:rotate-180 transition-transform"></i>
                        </summary>
                        <p class="text-xs text-slate-500 mt-2">Se recomienda anualmente o cuando ocurra un cambio disruptivo en la industria (tecnología, leyes o crisis global).</p>
                    </details>
                    <details class="group border-b border-slate-200 dark:border-slate-700 pb-2">
                        <summary class="list-none cursor-pointer font-medium flex justify-between items-center">
                            ¿Qué buscan los inversores?
                            <i class="fas fa-chevron-down group-open:rotate-180 transition-transform"></i>
                        </summary>
                        <p class="text-xs text-slate-500 mt-2">Buscan un TAM grande (>1B$) y un SOM realista que demuestre tracción inmediata y capacidad de ejecución.</p>
                    </details>
                </div>
            </div>
        </section>

        <!-- ACCIONES FINALES -->
        <div class="flex flex-wrap justify-center gap-4 py-10 border-t dark:border-slate-800">
            <button onclick="exportToCSV()" class="px-6 py-3 bg-green-600 text-white rounded-xl hover:bg-green-700 transition-all shadow-lg shadow-green-600/20">
                <i class="fas fa-file-excel mr-2"></i>Exportar Excel
            </button>
            <button onclick="exportToPDF()" class="px-6 py-3 bg-red-600 text-white rounded-xl hover:bg-red-700 transition-all shadow-lg shadow-red-600/20">
                <i class="fas fa-file-pdf mr-2"></i>Descargar PDF
            </button>
        </div>

    </main>

    <footer class="text-center p-10 text-slate-400 text-sm">
        <p>© 2023 MarketScale Pro. Herramienta Profesional de Análisis de Mercado.</p>
    </footer>

    <script>
        let marketChart;
        
        // Inicialización
        document.addEventListener('DOMContentLoaded', () => {
            initChart();
            calculate();
        });

        function toggleDarkMode() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-icon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                icon.className = 'fas fa-moon';
            } else {
                html.classList.add('dark');
                icon.className = 'fas fa-sun';
            }
        }

        function initChart() {
            const ctx = document.getElementById('marketChart').getContext('2d');
            marketChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['SOM (Obtenible)', 'SAM Restante', 'TAM Restante'],
                    datasets: [{
                        data: [0, 0, 0],
                        backgroundColor: ['#10b981', '#3b82f6', '#e2e8f0'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        function calculate() {
            // Inputs
            const tamValue = parseFloat(document.getElementById('tam-input').value) || 0;
            const samPerc = parseFloat(document.getElementById('sam-range').value) || 0;
            const somPerc = parseFloat(document.getElementById('som-range').value) || 0;
            const price = parseFloat(document.getElementById('price-input').value) || 0;
            const potentialClients = parseFloat(document.getElementById('clients-input').value) || 0;

            // Actualizar labels
            document.getElementById('sam-perc-val').innerText = samPerc + '%';
            document.getElementById('som-perc-val').innerText = somPerc + '%';

            // Cálculos
            const samValue = tamValue * (samPerc / 100);
            const somValue = samValue * (somPerc / 100);

            // Mostrar resultados formatados
            const formatter = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
            document.getElementById('tam-res').innerText = formatter.format(tamValue);
            document.getElementById('sam-res').innerText = formatter.format(samValue);
            document.getElementById('som-res').innerText = formatter.format(somValue);

            // Actualizar Gráfico
            marketChart.data.datasets[0].data = [somValue, samValue - somValue, tamValue - samValue];
            marketChart.update();

            // Actualizar Diagrama Visual (tamaños relativos)
            const samVisualPerc = 100 - (100 - samPerc) * 0.5; // Escala visual no lineal para que no desaparezca
            const somVisualPerc = 100 - (100 - somPerc) * 0.8;
            document.getElementById('v-sam').style.width = (samPerc * 3) + 'px';
            document.getElementById('v-sam').style.height = (samPerc * 3) + 'px';
            document.getElementById('v-som').style.width = (somPerc * 5) + 'px';
            document.getElementById('v-som').style.height = (somPerc * 5) + 'px';

            generateExecutiveSummary(tamValue, samValue, somValue);
        }

        function generateExecutiveSummary(tam, sam, som) {
            const summaryDiv = document.getElementById('executive-summary');
            const recList = document.getElementById('recommendations-list');
            
            let sizeText = tam > 1000000000 ? "un mercado masivo" : (tam > 100000000 ? "un mercado mediano-alto" : "un nicho de mercado");
            let somStatus = (som / sam) > 0.1 ? "ambicioso" : "conservador y realista";

            summaryDiv.innerHTML = `
                <p>Tu análisis revela que el negocio opera en <strong>${sizeText}</strong> con una valoración total (TAM) de ${document.getElementById('tam-res').innerText}.</p>
                <p>Con el modelo actual, puedes servir razonablemente al <strong>${document.getElementById('sam-perc-val').innerText}</strong> del mercado (SAM). Tu objetivo inicial de captación es del <strong>${document.getElementById('som-perc-val').innerText}</strong>, lo cual se considera un enfoque <strong>${somStatus}</strong>.</p>
            `;

            // Recomendaciones dinámicas
            let recs = [
                "Enfócate en marketing digital segmentado para reducir el costo de adquisición.",
                "Optimiza tu funnel de conversión para aumentar el SOM sin aumentar presupuesto.",
                "Considera alianzas estratégicas para convertir el SAM en SOM más rápidamente."
            ];

            if(som < sam * 0.02) recs.push("Tu SOM es bajo. Considera expandir tu fuerza de ventas.");
            if(tam < 1000000) recs.push("El mercado total es pequeño. Busca formas de aumentar el ticket promedio.");

            recList.innerHTML = recs.map(r => `<li class="flex items-start"><i class="fas fa-check-circle text-secondary mr-2 mt-1"></i> ${r}</li>`).join('');
        }

        function loadPreset(type) {
            if(type === 'saas') {
                document.getElementById('tam-input').value = 5000000;
                document.getElementById('sam-range').value = 20;
                document.getElementById('som-range').value = 5;
                document.getElementById('price-input').value = 50;
                document.getElementById('clients-input').value = 100000;
            } else if (type === 'cafe') {
                document.getElementById('tam-input').value = 500000;
                document.getElementById('sam-range').value = 60;
                document.getElementById('som-range').value = 10;
                document.getElementById('price-input').value = 4;
                document.getElementById('clients-input').value = 125000;
            } else if (type === 'gym') {
                document.getElementById('tam-input').value = 2000000;
                document.getElementById('sam-range').value = 15;
                document.getElementById('som-range').value = 8;
                document.getElementById('price-input').value = 40;
                document.getElementById('clients-input').value = 50000;
            }
            calculate();
        }

        function resetData() {
            document.getElementById('tam-input').value = 1000000;
            document.getElementById('sam-range').value = 30;
            document.getElementById('som-range').value = 5;
            document.getElementById('price-input').value = 100;
            document.getElementById('clients-input').value = 10000;
            calculate();
        }

        function exportToCSV() {
            const data = [
                ['Concepto', 'Porcentaje', 'Valor Monetario'],
                ['TAM', '100%', document.getElementById('tam-res').innerText],
                ['SAM', document.getElementById('sam-perc-val').innerText, document.getElementById('sam-res').innerText],
                ['SOM', document.getElementById('som-perc-val').innerText, document.getElementById('som-res').innerText]
            ];
            let csvContent = "data:text/csv;charset=utf-8," + data.map(e => e.join(",")).join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "analisis_mercado.csv");
            document.body.appendChild(link);
            link.click();
        }

        function exportToPDF() {
            const element = document.getElementById('report-content');
            const opt = {
                margin: 1,
                filename: 'Reporte_Mercado_TAM_SAM_SOM.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
</body>
</html>
